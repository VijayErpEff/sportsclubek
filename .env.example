# ===========================================
# LevelUP Sports — Environment Variables
# Copy this file to .env.local and fill in values
# ===========================================

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Meta Pixel (Facebook + Instagram ads). Loads only after marketing-cookie consent.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console Verification
# Get from: https://search.google.com/search-console → HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Bing Webmaster Tools Verification
# Get from: https://www.bing.com/webmasters → HTML tag method
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-verification-code

# Azure Communication Services — Email (contact form, newsletter, careers)
# Get from: Azure Portal → Communication Services → Keys → Connection string
ACS_CONNECTION_STRING="endpoint=https://<resource>.communication.azure.com/;accesskey=<key>"
ACS_SENDER_ADDRESS=DoNotReply@levelupsports.us
# Business inbox for notifications
# Comma-separated for multiple recipients, e.g. "info@levelupsports.us, owner@levelupsports.us"
CONTACT_EMAIL=info@levelupsports.us

# Upstash Redis (leads, applications, schedule, court status)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_PIN=6886

# LevelUP app — tournament registrations and payments live there; the website is the front door.
# LEVELUP_PUBLIC_SITE_KEY must equal PublicSite:ApiKey on that server. Server-side only.
LEVELUP_APP_API_BASE=https://app.levelupsports.us
LEVELUP_PUBLIC_SITE_KEY=
LEVELUP_SMASH_CUP_TOURNAMENT_ID=
# LPCL Kick Off (cricket league) — defaults to 2 when unset
LEVELUP_LPCL_TOURNAMENT_ID=2
